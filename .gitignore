# Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
# Real keys live in .env. The committed template is .env.example.
.env
.env.*
!.env.example

# Signing keys and provisioning
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.keystore

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
dist/
web-build/
coverage/

# ---------------------------------------------------------------------------
# Expo / React Native
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Generated by `expo prebuild` / `expo run:*`. Regenerated from app.json, so
# it does not belong in git unless we add custom native code.
/ios
/android
.kotlin/
*.orig.*

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ---------------------------------------------------------------------------
# Editors and tooling
# ---------------------------------------------------------------------------
# Claude Code's project settings — kept out of the repo by choice, so it
# does not come back if the tooling regenerates it.
.claude/

.idea/
.vscode/
*.iml
*.swp

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
