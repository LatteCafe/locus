# Copy this file to `.env` and paste in your own values.
#
# Supabase dashboard -> your project -> Project Settings -> Data API
#   EXPO_PUBLIC_SUPABASE_URL      = "Project URL"
# Supabase dashboard -> your project -> Project Settings -> API Keys
#   EXPO_PUBLIC_SUPABASE_ANON_KEY = the "anon" / "publishable" key
#
# The anon key is meant to be in the app: it only ever grants what Row Level
# Security allows. Never put the `service_role` key in this file — that one
# bypasses every policy and must stay on a server.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Needed to import study spots (npm run seed:places). Supabase dashboard ->
# Project Settings -> API Keys -> service_role (hidden behind "Reveal").
#
# NOTE there is no EXPO_PUBLIC_ prefix. This key bypasses every security rule,
# and anything named EXPO_PUBLIC_* is baked into the app that ships to phones.
SUPABASE_SERVICE_ROLE_KEY=

# Needed for the map to draw on ANDROID. Google Maps renders a blank grey
# screen without it, and gives no error saying why.
# Google Cloud console -> APIs & Services -> enable "Maps SDK for Android",
# then Credentials -> Create credentials -> API key.
# iOS uses Apple Maps and needs nothing here.
GOOGLE_MAPS_ANDROID_API_KEY=

# Sign in with Google needs an iOS client ID and a Web client ID from the
# Google Cloud console. Leave blank until you set those up; the app hides the
# Google button when they are missing.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
