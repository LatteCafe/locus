# Copy this file to `.env` and paste in your own values.
#
# Supabase dashboard -> your project -> Project Settings -> Data API
#   EXPO_PUBLIC_SUPABASE_URL      = "Project URL"
# Supabase dashboard -> your project -> Project Settings -> API Keys
#   EXPO_PUBLIC_SUPABASE_ANON_KEY = the "anon" / "publishable" key
#
# The anon key is meant to be in the app: it only ever grants what Row Level
# Security allows. Never put the `service_role` key in this file — that one
# bypasses every policy and must stay on a server.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sign in with Google needs an iOS client ID and a Web client ID from the
# Google Cloud console. Leave blank until you set those up; the app hides the
# Google button when they are missing.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
